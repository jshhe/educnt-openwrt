#!/bin/sh /etc/rc.common
# educnt 服务：后台调度器
USE_PROCD=1
START=95
STOP=10

start_service() {
	# 未配置账号时不启动，避免每 30 分钟刷错误日志
	[ -f /etc/educnt.conf ] || return 0

	# 只做取值，不 source，避免配置被篡改时以 root 执行任意代码
	USERNAME=$(sed -n "s/^USERNAME='\(.*\)'$/\1/p" /etc/educnt.conf | head -n 1)
	PASSWORD=$(sed -n "s/^PASSWORD='\(.*\)'$/\1/p" /etc/educnt.conf | head -n 1)

	[ -n "$USERNAME" ] || {
		logger -t educnt "未配置账号，服务未启动（请运行 educnt-setup）"
		return 0
	}
	[ -n "$PASSWORD" ] || return 0

	procd_open_instance
	procd_set_param command /bin/sh /usr/share/educnt/daemon.sh
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
